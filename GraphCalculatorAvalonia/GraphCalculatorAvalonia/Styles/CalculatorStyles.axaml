<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Button.file-action">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.play-animation">
        <Setter Property="Background" Value="#16A34A" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="ToolTip.Tip" Value="Анимировать все параметры от минимума до максимума за 5 секунд" />
        <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="Запустить анимацию всех параметров" />
    </Style>
    <Style Selector="Button.play-animation:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#15803D" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.play-animation:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#166534" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.play-animation.animating">
        <Setter Property="Background" Value="#DC2626" />
        <Setter Property="ToolTip.Tip" Value="Остановить анимацию и вернуть прежние значения" />
        <Setter Property="AutomationProperties.Name" Value="Остановить анимацию всех параметров" />
    </Style>
    <Style Selector="Button.play-animation.animating:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#B91C1C" />
    </Style>
    <Style Selector="Button.play-animation.animating:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#991B1B" />
    </Style>
    <Style Selector="Button.play-animation:disabled">
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="Background" Value="#E8EEF6" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="ToolTip.Tip" Value="Добавьте функцию с параметром" />
    </Style>
    <Style Selector="Button.play-animation:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#E8EEF6" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.play-animation Path.animation-pause-icon">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.play-animation.animating Path.animation-play-icon">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.play-animation.animating Path.animation-pause-icon">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.function-card">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="NumericUpDown.parameter-number">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="AllowSpin" Value="False" />
        <Setter Property="ClipValueToMinMax" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="NumericUpDown.parameter-bound">
        <Setter Property="Width" Value="72" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="4,1" />
    </Style>

    <Style Selector="Slider.parameter-slider /template/ Thumb, Slider.parameter-slider:pointerover /template/ Thumb, Slider.parameter-slider:pressed /template/ Thumb">
        <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
    </Style>
    <Style Selector="Slider.parameter-slider /template/ RepeatButton#PART_DecreaseButton, Slider.parameter-slider:pointerover /template/ RepeatButton#PART_DecreaseButton, Slider.parameter-slider:pressed /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
    </Style>

    <Style Selector="Border.function-card:pointerover">
        <Setter Property="BorderBrush" Value="#B8C8E3" />
    </Style>

    <Style Selector="TextBox.expression">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.add-function">
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.add-function:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1D4ED8" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.add-function:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#1E40AF" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.delete-function">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.delete-function:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FEF2F2" />
        <Setter Property="Foreground" Value="#DC2626" />
    </Style>

    <Style Selector="ToggleButton.visibility">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.visibility Ellipse">
        <Setter Property="Opacity" Value="0.25" />
    </Style>
    <Style Selector="ToggleButton.visibility:checked Ellipse">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.visibility:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="BorderBrush" Value="#94A3B8" />
    </Style>
    <Style Selector="ToggleButton.visibility:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E2E8F0" />
        <Setter Property="Foreground" Value="#475569" />
    </Style>
    <Style Selector="ToggleButton.visibility:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E2E8F0" />
    </Style>

    <Style Selector="Button.color-picker, Button.color-swatch">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.color-picker:pointerover /template/ ContentPresenter, Button.color-swatch:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E2E8F0" />
    </Style>

    <!-- Keep the animated values readable while the editor is locked. -->
    <Style Selector="Border.function-card:disabled">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="#DCE5EF" />
    </Style>
    <Style Selector="TextBox.expression:disabled">
        <Setter Property="Foreground" Value="#475569" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="TextBox.expression:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="NumericUpDown.parameter-number:disabled">
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="Background" Value="#EFF4F9" />
        <Setter Property="BorderBrush" Value="#DFE7F0" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="NumericUpDown.parameter-number:disabled /template/ TextBox#PART_TextBox">
        <Setter Property="Foreground" Value="#334155" />
    </Style>
    <Style Selector="NumericUpDown.parameter-number:disabled /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Slider.parameter-slider:disabled /template/ Thumb">
        <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Slider.parameter-slider:disabled /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="Slider.parameter-slider:disabled /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="#DFE7F0" />
    </Style>
    <Style Selector="Button.add-function:disabled">
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.add-function:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#E8EEF6" />
        <Setter Property="BorderBrush" Value="#DCE5EF" />
        <Setter Property="Foreground" Value="#64748B" />
    </Style>
    <Style Selector="Button.delete-function:disabled, Button.color-picker:disabled, ToggleButton.visibility:disabled">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.delete-function:disabled /template/ ContentPresenter, Button.color-picker:disabled /template/ ContentPresenter, ToggleButton.visibility:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#94A3B8" />
    </Style>

    <Style Selector="GridSplitter.panel-divider">
        <Setter Property="Background" Value="#E2E8F0" />
    </Style>
    <Style Selector="GridSplitter.panel-divider:pointerover">
        <Setter Property="Background" Value="#93C5FD" />
    </Style>
</Styles>
