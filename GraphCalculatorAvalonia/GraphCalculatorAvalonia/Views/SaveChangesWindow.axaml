<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GraphCalculatorAvalonia.Views.SaveChangesWindow"
        Title="Сохранить изменения?" Width="520" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#0F172A">
    <Window.Styles>
        <StyleInclude Source="/Styles/CalculatorStyles.axaml" />
    </Window.Styles>
    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="Сохранить изменения?" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="В документе есть несохранённые изменения. Сохранить их перед загрузкой другого файла?"
                   TextWrapping="Wrap" Foreground="#64748B" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Отмена" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Не сохранять" Click="OnDiscardClick" />
            <Button Content="Сохранить" Classes="add-function" Padding="16,8" MinHeight="34"
                    Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
