<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GraphCalculatorAvalonia.ViewModels"
        xmlns:palette="using:GraphCalculatorAvalonia.Styles"
        xmlns:media="using:Avalonia.Media"
        xmlns:controls="using:GraphCalculatorAvalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="GraphCalculatorAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/avalonia-logo.ico"
        Title="Графический калькулятор"
        Width="1100" Height="700"
        MinWidth="720" MinHeight="400"
        Background="#F3F6FB" Foreground="#0F172A">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    <Window.Styles>
        <StyleInclude Source="/Styles/CalculatorStyles.axaml" />
    </Window.Styles>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="260" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F8FAFC">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" Spacing="12">
                        <ItemsControl ItemsSource="{Binding Functions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FunctionViewModel">
                                    <Border Classes="function-card">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                                            <ToggleButton Classes="visibility" Margin="0,0,6,0"
                                                          IsChecked="{Binding IsVisible, Mode=OneWay}"
                                                          Command="{Binding ChangeVisibilityCommand}"
                                                          ToolTip.Tip="Показать или скрыть график функции"
                                                          AutomationProperties.Name="Видимость функции">
                                                <Ellipse Width="12" Height="12"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding GraphColor}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </ToggleButton>
                                            <TextBox Classes="expression" Grid.Column="1" Text="{Binding Expression, Mode=TwoWay}"
                                                     PlaceholderText="f(x)"
                                                     AutomationProperties.Name="Выражение функции" />
                                            <Button Classes="color-picker" Grid.Column="2" Margin="4,0,0,0"
                                                    ToolTip.Tip="Выбрать цвет графика"
                                                    AutomationProperties.Name="Выбрать цвет графика">
                                                <Ellipse Width="16" Height="16">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding GraphColor}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <StackPanel Spacing="12">
                                                            <TextBlock Text="Цвет графика" FontWeight="SemiBold" />
                                                            <ItemsControl ItemsSource="{x:Static palette:GraphPalette.PaletteColors}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="media:Color">
                                                                        <Button Classes="color-swatch"
                                                                                AutomationProperties.Name="{Binding}"
                                                                                ToolTip.Tip="{Binding}"
                                                                                Command="{Binding $parent[ItemsControl].((vm:FunctionViewModel)DataContext).SetColorCommand}"
                                                                                CommandParameter="{Binding}">
                                                                            <Ellipse Width="20" Height="20">
                                                                                <Ellipse.Fill>
                                                                                    <SolidColorBrush Color="{Binding}" />
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Classes="delete-function" Grid.Column="3" Content="×" Margin="4,0,0,0"
                                                    ToolTip.Tip="Удалить функцию"
                                                    AutomationProperties.Name="Удалить функцию"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteFunctionCommand}"
                                                    CommandParameter="{Binding}" />
                                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="4"
                                                          ItemsSource="{Binding Parameters}"
                                                          IsVisible="{Binding HasParameters}" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FunctionParameterModelView">
                                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,8,*" Margin="0,3">
                                                            <Grid Grid.ColumnSpan="3" ColumnDefinitions="Auto,*">
                                                                <TextBlock Text="{Binding Title}" MinWidth="20"
                                                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                                                                <NumericUpDown Classes="parameter-number" Grid.Column="1" Width="104"
                                                                               HorizontalAlignment="Right"
                                                                               Value="{Binding Value, Mode=TwoWay}"
                                                                               Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                                                               AutomationProperties.Name="{Binding Title, StringFormat='Значение параметра {0}'}" />
                                                            </Grid>
                                                            <Slider Classes="parameter-slider" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,2"
                                                                    Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                                                    Value="{Binding Value, Mode=TwoWay}"
                                                                    AutomationProperties.Name="{Binding Title}">
                                                                <Slider.Foreground>
                                                                    <SolidColorBrush Color="{Binding $parent[ItemsControl].((vm:FunctionViewModel)DataContext).GraphColor}" />
                                                                </Slider.Foreground>
                                                                <Slider.Resources>
                                                                    <GridLength x:Key="SliderPreContentMargin">0</GridLength>
                                                                    <GridLength x:Key="SliderPostContentMargin">0</GridLength>
                                                                    <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
                                                                    <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
                                                                    <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
                                                                </Slider.Resources>
                                                            </Slider>
                                                                <NumericUpDown Classes="parameter-number parameter-bound" Grid.Row="2"
                                                                               HorizontalAlignment="Left" TextAlignment="Left"
                                                                               Value="{Binding MinValue, Mode=TwoWay}"
                                                                               Maximum="{Binding MaxValue}"
                                                                               ToolTip.Tip="Минимум"
                                                                               AutomationProperties.Name="{Binding Title, StringFormat='Минимум параметра {0}'}" />
                                                                <NumericUpDown Classes="parameter-number parameter-bound" Grid.Row="2" Grid.Column="2"
                                                                               HorizontalAlignment="Right" TextAlignment="Right"
                                                                               Value="{Binding MaxValue, Mode=TwoWay}"
                                                                               Minimum="{Binding MinValue}"
                                                                               ToolTip.Tip="Максимум"
                                                                               AutomationProperties.Name="{Binding Title, StringFormat='Максимум параметра {0}'}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,8,0,0"
                                                       Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                                                       TextWrapping="Wrap" FontSize="12" Foreground="#DC2626" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="add-function" Command="{Binding AddFunctionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 0,6 L 12,6 M 6,0 L 6,12" Stroke="White"
                                      StrokeThickness="1.5" Width="12" Height="12"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Добавить функцию" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
        </Border>

        <GridSplitter Classes="panel-divider" Grid.Column="1" ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <controls:GraphView Grid.Column="2" Functions="{Binding Functions}" AutomationProperties.Name="Координатная плоскость" />
    </Grid>
</Window>
